{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowListGetPutFromAccountRoot",
            "Effect": "Allow",
            "Principal": {
                "AWS": "<ROOT_USER_ARN>"
            },
            "Action": [
                "s3:ListBucket",
                "s3:GetObject",
                "s3:PutObject"
            ],
            "Resource": [
                "arn:aws:s3:::<BUCKET_NAME>",
                "arn:aws:s3:::<BUCKET_NAME>/*"
            ]
        }
    ]
}