{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowListGetPutFromAccountRoot",
            "Effect": "Allow",
            "Principal": {
                "AWS": "ROOT USER ARN"
            },
            "Action": [
                "s3:ListBucket",
                "s3:GetObject",
                "s3:PutObject"
            ],
            "Resource": [
                "arn:aws:s3:::dannykbucket",
                "arn:aws:s3:::dannykbucket/*"
            ]
        }
    ]
}